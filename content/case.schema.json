{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SLEPZOF Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "summary",
    "industry",
    "year",
    "sections",
    "seo",
    "status"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "industry": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "minimum": 2010
    },
    "period": {
      "type": "string"
    },
    "cover_image": {
      "type": "string",
      "pattern": "^/assets/cases/"
    },
    "hero_image": {
      "type": "string",
      "pattern": "^/assets/cases/"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "intro",
              "text",
              "image",
              "gallery",
              "metric",
              "quote",
              "result"
            ]
          },
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "value": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "source_note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "seo": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "string"
        },
        "noindex": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
